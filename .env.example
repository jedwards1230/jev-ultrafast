# Optional: any System One server (e.g. a LiteLLM proxy or Ollama serving Clef).
# TYPESAFE_API_BASE=https://api.typesafe.ai
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# Optional JSON merged into text-helper requests, replacing the reasoning setting above.
# Ollama: TEXT_MODEL_EXTRA_BODY='{"reasoning_effort":"none"}'
# Per-question option limit of the decision server (Jev 255, Ollama's Clef 26).
# CHOICE_MAX_CANDIDATES=26
